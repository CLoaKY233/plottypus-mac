// Debug configurations for plottypus.
// GDB is unavailable on Apple Silicon — CodeLLDB only.
// "sourceLanguages": ["rust"] is REQUIRED by CodeLLDB for Rust type formatting.
[
  {
    "label": "Debug plottypus (TUI)",
    "adapter": "CodeLLDB",
    "request": "launch",
    "build": {
      "command": "cargo",
      "args": ["build", "--package", "plottypus"]
    },
    "program": "$ZED_WORKTREE_ROOT/target/debug/plottypus",
    "cwd": "$ZED_WORKTREE_ROOT",
    "sourceLanguages": ["rust"],
    "env": {
      "RUST_BACKTRACE": "1",
      "RUST_LOG": "debug"
    },
    // A TUI owns the terminal — run it in an external one so the
    // debugger console and the alternate screen do not fight.
    "terminal": "external"
  },
  {
    "label": "Debug workspace tests",
    "adapter": "CodeLLDB",
    // Zed infers the test binary path from a `cargo test` build command.
    "build": {
      "command": "cargo",
      "args": ["test", "--workspace", "--no-run"]
    },
    "cwd": "$ZED_WORKTREE_ROOT",
    "sourceLanguages": ["rust"],
    "env": {
      "RUST_BACKTRACE": "full"
    }
  },
  {
    "label": "Attach to running plottypus",
    "adapter": "CodeLLDB",
    "request": "attach",
    "program": "$ZED_WORKTREE_ROOT/target/debug/plottypus",
    "sourceLanguages": ["rust"]
  }
]
